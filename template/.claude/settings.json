{
  "permissions": {
    "allow": [
      "Bash(docker compose up *)",
      "Bash(docker compose run *)",
      "Bash(docker compose down *)",
      "Bash(docker compose logs *)",
      "Bash(npm run validate-lab *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/validate-on-lab-edit.sh"
          }
        ]
      }
    ]
  }
}
