{
  "name": "@dockersamples/simspace-labspace",
  "version": "0.1.0",
  "description": "The Labspace lab runtime as an embeddable React component: instruction panel, multi-terminal shared state, and the CI tab, driven by a labspace.yaml.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./loader": "./dist/loader.js",
    "./styles/icons.css": "./dist/styles/icons.css",
    "./styles.css": "./dist/styles.css"
  },
  "dependencies": {
    "@dockersamples/simspace-simulator": "*",
    "copy-to-clipboard": "^3.3.3",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^3.0.3",
    "react-syntax-highlighter": "^16.1.0",
    "rehype-github-alerts": "^4.1.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-raw": "^7.0.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "unist-util-visit": "^5.0.0",
    "yaml": "^2.6.1"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "scripts": {
    "build": "node ../../scripts/build-package.mjs .",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "jsdom": "^30.0.1",
    "subset-font": "^2.5.0"
  }
}
